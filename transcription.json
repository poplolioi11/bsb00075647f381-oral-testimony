      "image": 1,
      "sides": [
        {
          "side": "right",
          "columns": [
            {
              "text": "麋臺鹿苑之間有某明經焉"
            },
            {
              "text": "鬱々家居致成心疾書空咄"
            },
            {
              "text": "咄不減殷浩當年室人某氏"
            },
            {
              "text": "賢慧性成居賤食貧絶無怨"
            },
            {
              "text": "色一日明經忽至某署大堂"
            },
            {
              "text": "擊鼓叫喊差役大驚奔告明"
            },
            {
              "text": "府明府立出登堂見其滿身"
            },
            {
              "text": "血污急詢有何奇寃答稱為"
            },
            {
              "text": "妻所毆將有性命之憂急迫"
            },
            {
              "text": "至此明府見其情狀似若可"
            },
            {
              "text": "信立飭差役往提其妻其妻"
            },
            {
              "text": "茫無頭緒隨差到署據供丈"
            },
            {
              "text": "夫素有瘋症此次實由渠自"
            },
            {
              "text": "用花瓶擊破頭顱並非小婦"
            },
            {
              "text": "人所毆明府覆問明經則目"
            },
            {
              "text": "瞪口呆語無倫次未幾其"
            }
          ],
