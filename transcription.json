        {
          "side": "left",
          "columns": [
            {
              "text": "姪某茂才亦至訴明叔病"
            },
            {
              "text": "情形遂領歸焉兼聽則"
            },
            {
              "text": "明偏聽則暗世有訊鞫"
            },
            {
              "text": "之責者其可據一面之"
            },
            {
              "text": "詞而漫加刑責哉"
            }
          ],
